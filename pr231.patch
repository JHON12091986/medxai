+import asyncio
+import json
+import re
+from typing import List
+from core.router import HybridRouter, ClassifiedTask
+from core.logger import get_logger
+
+logger = get_logger("nina.godmode")
+
+class GodModeEngine:
+    """
+    Multi-level tasking engine that decomposes goals, routes them in parallel,
+    applies Intelligent Receiving (feedback loops), and synthesizes the final output.
+    """
+    def __init__(self, router: HybridRouter):
+        self.router = router
+
+    def _extract_json_list(self, text: str) -> List[str]:
+        try:
+            # Look for a JSON array block
+            match = re.search(r'\[.*\]', text, re.DOTALL)
+            if match:
+                parsed = json.loads(match.group(0))
+                if isinstance(parsed, list):
+                    return [str(x) for x in parsed]
+        except Exception as e:
+            logger.warning(f"JSON extraction failed in decompose: {e}")
+        
+        # Fallback heuristic: split by numbered lists or lines
+        lines = [l.strip().lstrip('-*1234567890. ') for l in text.splitlines() if len(l.strip()) > 15]
+        return lines if lines else [text]
+
+    async def _decompose(self, task: str) -> List[str]:
+        prompt = (
+            "Break down the following complex task into 3 to 5 independent, highly specific, "
+            "miniature sub-tasks that can be executed in parallel. "
+            "Return ONLY a valid JSON array of strings.\n\n"
+            f"TASK: {task}"
+        )
+        # Use a high-speed model for structural breakdown
+        spec = ClassifiedTask("quick", 400, True, False)
+        logger.info(f"Decomposing task: {task[:50]}...")
+        response = await self.router.route("decompose", [{"role": "user", "content": prompt}], spec)
+        sub_tasks = self._extract_json_list(response)
+        logger.info(f"Task decomposed into {len(sub_tasks)} streams.")
+        return sub_tasks
+
+    async def _execute_and_validate(self, leaf_task: str, context: str) -> str:
+        # 1. Execute
+        prompt = f"Context Context:\n{context}\n\nExecute this specific miniature task comprehensively:\n{leaf_task}"
+        spec = ClassifiedTask("coding", 2500, True, False)
+        
+        logger.info(f"[Act] Routing leaf task: {leaf_task[:30]}...")
+        result = await self.router.route("execute", [{"role": "user", "content": prompt}], spec)
+
+        # 2. Intelligent Receiving (OODA Feedback Loop)
+        eval_prompt = (
+            f"Review this execution for the task: '{leaf_task}'.\n"
+            "Apply intelligence. Do not blindly accept it. Check for completeness, logical rigor, and accuracy.\n"
+            "If it is fully complete and perfect, reply EXACTLY with the word 'PERFECT'.\n"
+            "If there are flaws, omissions, or assumptions, list them clearly."
+        )
+        eval_spec = ClassifiedTask("quick", 500, False, False)
+        
+        # Use a local or high-speed model as a strict Logic Gate
+        evaluation = await self.router.route(
+            "evaluate", 
+            [
+                {"role": "system", "content": "You are a ruthless, omnipotent QA logic gate."},
+                {"role": "user", "content": f"RESULT TO EVALUATE:\n{result}\n\n{eval_prompt}"}
+            ], 
+            eval_spec, 
+            force_local=True
+        )
+
+        if "PERFECT" not in evaluation:
+            # 3. Refine (Adapt)
+            logger.warning(f"[Feedback] Refining task '{leaf_task[:30]}...' based on QA gate.")
+            refine_prompt = (
+                f"Your previous result failed the Logic Gate. Feedback:\n{evaluation}\n\n"
+                f"Fix the flaws and output the absolute corrected result. Previous attempt:\n{result}"
+            )
+            # Re-route to a high-tier model for the fix
+            result = await self.router.route("refine", [{"role": "user", "content": refine_prompt}], spec)
+        else:
+            logger.info(f"[Receive] Task '{leaf_task[:30]}...' passed Logic Gate.")
+
+        return f"--- Sub-Task: {leaf_task} ---\n{result}\n"
+
+    async def run(self, main_task: str, context: str = "") -> str:
+        logger.info("⚡ GOD MODE Activated. Engaging Multi-Level Engine.")
+        
+        # Level 1: Sub-tasks
+        sub_tasks = await self._decompose(main_task)
+        
+        # Level 2: Parallel Execution with Intelligence in Receiving
+        tasks = [self._execute_and_validate(st, context) for st in sub_tasks]
+        results = await asyncio.gather(*tasks)
+        
+        # Level 3: Synthesis
+        logger.info("⚡ Synthesizing parallel streams into master output...")
+        synth_prompt = (
+            f"Synthesize these parallel executions into a single, cohesive, "
+            f"absolute master output for the original objective: '{main_task}'.\n\n" + 
+            "\n\n".join(results)
+        )
+        synth_spec = ClassifiedTask("research", 6000, False, False)
+        final_result = await self.router.route(
+            "synthesize", 
+            [
+                {"role": "system", "content": "You are the Chief Orchestrator assembling the ultimate solution."},
+                {"role": "user", "content": synth_prompt}
+            ], 
+            synth_spec
+        )
+        
+        logger.info("✅ GOD MODE execution complete.")
+        return final_result
