index 0000000..f0e195e
--- /dev/null
+++ b/tools/omniscient_optimizer.py
@@ -0,0 +1,81 @@
+import os
+import subprocess
+import json
+from datetime import datetime
+
+# --- OMNISCIENT OPTIMIZER ---
+# Goal: Continuous size reduction and efficiency across 5 bases
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+def log_action(base, action, details):
+    ts = datetime.now().isoformat()
+    entry = {"ts": ts, "base": base, "action": action, "details": details}
+    try:
+        with open(os.path.join(REPO_ROOT, "logs/optimizer.log"), "a") as f:
+            f.write(json.dumps(entry) + "\n")
+    except Exception:
+        pass
+
+def run_cmd(cmd):
+    try:
+        return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL)
+    except subprocess.CalledProcessError:
+        return ""
+
+def optimize_codebase():
+    """Removes __pycache__, .pytest_cache, and orphaned compiled files."""
+    print("-> Optimizing CODEBASE...")
+    run_cmd(f"find {REPO_ROOT} -type d -name '__pycache__' -exec rm -rf {{}} +")
+    run_cmd(f"find {REPO_ROOT} -type d -name '.pytest_cache' -exec rm -rf {{}} +")
+    log_action("codebase", "purge_cache", "Removed __pycache__ and test caches.")
+
+def optimize_logbase():
+    """Archives old logs, keeping only the last 3 days active."""
+    print("-> Optimizing LOGBASE...")
+    logs_dir = os.path.join(REPO_ROOT, "logs")
+    if os.path.exists(logs_dir):
+        cmd = f"find {logs_dir} -type f -name '*.log.*' -mtime +3 -exec tar -rvf {logs_dir}/archive.tar {{}} \\; -exec rm {{}} \\;"
+        run_cmd(cmd)
+        run_cmd(f"gzip -f {logs_dir}/archive.tar")
+        log_action("logbase", "rotate_archive", "Archived and compressed logs older than 3 days.")
+
+def optimize_memorybase():
+    """Prunes dead session vectors and older memory facts."""
+    print("-> Optimizing MEMORYBASE...")
+    mem_file = os.path.join(REPO_ROOT, "data/session_memory.jsonl")
+    if os.path.exists(mem_file):
+        try:
+            lines = open(mem_file).readlines()
+            if len(lines) > 500:
+                with open(mem_file, "w") as f:
+                    f.writelines(lines[-200:])
+                log_action("memorybase", "truncate", f"Truncated session_memory.jsonl from {len(lines)} to 200 lines.")
+        except Exception: pass
+
+def optimize_docbase():
+    """Compresses the heavy 'upgrades/backups' docbase."""
+    print("-> Optimizing DOCBASE...")
+    bkp_dir = os.path.join(REPO_ROOT, "upgrades/backups")
+    if os.path.exists(bkp_dir):
+        cmd = f"find {bkp_dir} -type d -name 'codebase_*' -mtime +2 -exec tar -czvf {{}}.tar.gz {{}} \\; -exec rm -rf {{}} \\;"
+        run_cmd(cmd)
+        log_action("docbase", "compress_backups", "Compressed stale docbase codebase_* backups.")
+
+def optimize_txtbase():
+    """Cleans up raw text traces from incidents."""
+    print("-> Optimizing TXTBASE...")
+    incidents_dir = os.path.join(REPO_ROOT, "upgrades/incidents")
+    if os.path.exists(incidents_dir):
+        cmd = f"find {incidents_dir} -type f -name '*.txt' -mtime +7 -exec rm {{}} \\;"
+        run_cmd(cmd)
+        log_action("txtbase", "purge_stale_txt", "Removed incident txt traces older than 7 days.")
+
+if __name__ == "__main__":
+    print("=== NINA OMNISCIENT OPTIMIZER ===")
+    optimize_codebase()
+    optimize_logbase()
+    optimize_memorybase()
+    optimize_docbase()
+    optimize_txtbase()
+    print("=== OPTIMIZATION COMPLETE ===")
