+import json
+import subprocess
+import os
+import re
+from datetime import datetime
+from urllib import request
+
+NINAGATE_URL = "http://localhost:8080/v1/chat/completions"
+MODEL = "gemini-3.5-flash"
+
+def query_llm(prompt):
+    payload = json.dumps({
+        "model": MODEL, 
+        "messages": [{"role": "user", "content": prompt}], 
+        "stream": False
+    }).encode("utf-8")
+    req = request.Request(NINAGATE_URL, data=payload, headers={"Content-Type": "application/json"})
+    try:
+        with request.urlopen(req, timeout=120) as res:
+            return json.loads(res.read().decode())["choices"][0]["message"]["content"]
+    except Exception as e:
+        return f"Error querying NinaGate LLM: {e}"
+
+def get_git_diff_stat():
+    try:
+        return subprocess.check_output(["git", "diff", "--cached", "--stat"], text=True)
+    except Exception:
+        return ""
+
+def get_git_diff_compact():
+    try:
+        return subprocess.check_output(["git", "diff", "--cached", "--unified=0"], text=True)
+    except Exception:
+        return ""
+
+def get_recent_scratchpad(lines=30):
+    try:
+        with open("data/gemini_scratch.jsonl", "r") as f:
+            return "".join(f.readlines()[-lines:])
+    except Exception:
+        return ""
+
+def get_last_entry_num():
+    try:
+        with open("nina_update_log.md", "r") as f:
+            content = f.read()
+            matches = re.findall(r"^## Entry (\d+)", content, re.MULTILINE)
+            if matches:
+                return int(max(matches))
+    except Exception:
+        pass
+    return 0
+
+def main():
+    stat = get_git_diff_stat()
+    if not stat.strip():
+        print("No staged changes to document.")
+        return
+
+    diff_compact = get_git_diff_compact()
+    scratchpad = get_recent_scratchpad(lines=30)
+    
+    prompt = f"""Summarize this dev session for NINA. Be extremely concise.
+Format:
+**Work:** (1 sentence)
+**Files:** (stat list)
+**Insight:** (1 sentence logic)
+
+Stats:
+{stat}
+
+Changes:
+{diff_compact[:2000]}
+
+Recent Logic:
+{scratchpad[-1000:]}
+"""
+    print("Querying Auto-Doc Engine (Proxy FAST)...")
+    summary = query_llm(prompt)
+    if "Error" in summary:
+        summary = "**Work:** Fallback documentation generated.\n**Files:** " + subprocess.getoutput("git diff --cached --name-only").replace("\n", ", ")
+
+    next_num = str(get_last_entry_num() + 1).zfill(3)
+    date_str = datetime.now().strftime("%Y-%m-%d")
+    
+    entry = f"\n\n---\n\n## Entry {next_num} — {date_str} · Autonomous Session Doc\n\n**Triggered by:** Auto-Doc Engine (Fast-Mode)\n\n{summary.strip()}\n"
+    
+    for path in ["nina_update_log.md", "logs/nina_update_log.md"]:
+        if os.path.exists(path):
+            with open(path, "a") as f:
+                f.write(entry)
+            print(f"✅ Appended Auto-Doc to {path}")
+
+if __name__ == "__main__":
+    main()
