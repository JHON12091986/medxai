#!/usr/bin/env bash
# =============================================================================
# git-hooks/pre-push  —  RETIRED for ngit pushes
#
# ngit uses --no-verify on all pushes, so this hook never fires during
# normal ngit usage. OODA is handled by post-push hook instead.
#
# This file is kept for manual `git push` calls (without --no-verify)
# that come from tools like Jules, agy, or Gemini.
#
# For those cases: governance index is regenerated synchronously.
# =============================================================================

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "$HOME/nina")
LOG="$REPO_ROOT/runtime/logs/nina_sync.log"

# Skip if ngit/nina_sync already set the in-flight flag
[[ -f "$REPO_ROOT/.push_in_flight" ]] && exit 0

# External push (Jules/agy/Gemini) — run governance only
bash "$REPO_ROOT/scripts/nina_sync.sh" audit >> "$LOG" 2>&1 &

exit 0
