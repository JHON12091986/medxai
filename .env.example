# Environment variables required for NINA

# Telegram Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
AUTHORIZED_USER_ID="your_telegram_user_id_here"

# Model API Keys
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
CEREBRAS_API_KEY="your_cerebras_api_key_here"
MISTRAL_API_KEY="your_mistral_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
TOGETHER_API_KEY="your_together_api_key_here"
COHERE_API_KEY="your_cohere_api_key_here"
MODEL_OVERRIDES='{}'  # JSON dict mapping provider IDs to model strings

# Jules / GCP Configuration
JULES_API_KEY="your_jules_api_key_here"
GCP_PROJECT_ID="your_gcp_project_id_here"

# Optional Subsystems
# PLAYWRIGHT_WS_ENDPOINT="wss://..."
# EXCHANGE_USERNAME="your_email"
# EXCHANGE_PASSWORD="your_password"
