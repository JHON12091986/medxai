# Environment variables required for NINA
# ─────────────────────────────────────────────────────────────────────────────
# CANONICAL keys only — do NOT add no-underscore aliases (TELEGRAMCHATID etc.)
# Canonical = snake_case ALL_CAPS. One key per concept. Period.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"       # numeric chat/user ID
# AUTHORIZED_USER_ID= # DEAD — use TELEGRAM_CHAT_ID instead
API_SECRET_KEY="your_api_secret_key_here"

# ── Model API Keys ────────────────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
CEREBRAS_API_KEY="your_cerebras_api_key_here"
MISTRAL_API_KEY="your_mistral_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
TOGETHER_API_KEY="your_together_api_key_here"
COHERE_API_KEY="your_cohere_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"
PERPLEXITY_API_KEY="your_perplexity_api_key_here"
FIREWORKS_API_KEY="your_fireworks_api_key_here"
NOVITA_API_KEY="your_novita_api_key_here"
SAMBANOVA_API_KEY="your_sambanova_api_key_here"
HYPERBOLIC_API_KEY="your_hyperbolic_api_key_here"
XAI_API_KEY="your_xai_api_key_here"
MODEL_OVERRIDES='{}'

# ── Jules / GCP ───────────────────────────────────────────────────────────────
JULES_API_KEY="your_jules_api_key_here"
GCP_PROJECT_ID="your_gcp_project_id_here"

# ── Optional: OneBrain / OneDrive proxy ──────────────────────────────────────
ONEBRAIN_API_BASE=""
ONEBRAIN_API_KEY=""

# ── Optional: Local Ollama ────────────────────────────────────────────────────
OLLAMA_HOST=""

# ── Optional: EWS / Exchange email ───────────────────────────────────────────
EWS_MY_EMAIL=""
EWS_SHARED_EMAIL=""
EWS_USERNAME=""
EWS_PASSWORD=""

# ── Optional: Playwright remote browser ──────────────────────────────────────
# PLAYWRIGHT_WS_ENDPOINT="wss://..."

# ── Runtime tuning ───────────────────────────────────────────────────────────
HYPERDRIVE_ENABLED=""
IDLE_AUTO_APPROVE=""
IDLE_REPORT_MIN=""
IDLE_THRESHOLD_MIN=""
RAM_GUARD_GB=""
DEADMAN_PING_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# REMOVED (aliases — never re-add):
#   TELEGRAMCHATID      → use TELEGRAM_CHAT_ID
#   TELEGRAMBOTTOKEN    → use TELEGRAM_BOT_TOKEN
#   AUTHORIZEDUSERID    → use AUTHORIZED_USER_ID
#   OLLAMAHOST          → use OLLAMA_HOST
#   ONEBRAIN*           → use ONEBRAIN_API_BASE / ONEBRAIN_API_KEY
#   EWSPASSWORD         → use EWS_PASSWORD
#   DEADMANPINGURL      → use DEADMAN_PING_URL
# ─────────────────────────────────────────────────────────────────────────────
