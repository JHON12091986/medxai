# ─────────────────────────────────────────────
# NINA v12 — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_ID=your_telegram_user_id_here

# ── AI PROVIDERS (at least one required) ──────
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
NOVITA_API_KEY=
ONEBRAIN_API_KEY=
ONEBRAIN_API_BASE=

# ── OLLAMA (local models) ──────────────────────
OLLAMA_HOST=http://localhost:11434

# ── EMAIL / EWS (optional) ────────────────────
EWS_PASSWORD=
EWS_USERNAME=
EWS_MY_EMAIL=
EWS_SHARED_EMAIL=

# ── API SERVER (optional) ─────────────────────
API_SECRET_KEY=

# ── DEAD MAN SWITCH (optional) ────────────────
DEAD_MAN_PING_URL=

# ── BEHAVIOUR OVERRIDES (optional) ────────────
IDLE_AUTO_APPROVE=false
IDLE_THRESHOLD_MIN=15
IDLE_REPORT_MIN=30
