#!/bin/bash
# ~/bin/gemini — NINA Gemini CLI shim
# Intercepts gemini calls, falls back to NinaGate when quota exhausted

REAL_GEMINI="/home/aibony/.npm-global/bin/gemini"
QUOTA_FILE="$HOME/nina/data/quota_state.json"
NINAGATE_URL="http://localhost:8080/v1/chat/completions"
FALLBACK_MODEL="gemini-2.5-flash"

# Read quota from quota_state.json
GEMINI_QUOTA=$(python3 -c "
import json, os, sys
try:
    quota_file_path = os.path.expanduser('$QUOTA_FILE')
    if not os.path.exists(quota_file_path):
        print(900)
    else:
        with open(quota_file_path, 'r') as f:
            d = json.load(f)
        used = d.get('quotas', {}).get('gemini', 0)
        print(max(0, 900 - used))
except Exception as e:
    print(0)
" 2>/dev/null)

# Passthrough if quota alive and real binary exists
if [ "$GEMINI_QUOTA" -gt 0 ] && [ -x "$REAL_GEMINI" ]; then
    exec "$REAL_GEMINI" "$@"
fi

# Quota exhausted or binary gone — route through NinaGate via python to prevent json/quoting issues
python3 -c "
import urllib.request, json, sys, os

prompt = ' '.join(sys.argv[1:])
if not prompt:
    print('[nina-shim] No prompt provided.', file=sys.stderr)
    sys.exit(1)

print(f'[nina-shim] Gemini CLI quota exhausted or binary missing — routing via NinaGate ($FALLBACK_MODEL)', file=sys.stderr)

url = '$NINAGATE_URL'
payload = {
    'model': '$FALLBACK_MODEL',
    'messages': [{'role': 'user', 'content': prompt}]
}
data = json.dumps(payload).encode('utf-8')
req = urllib.request.Request(
    url,
    data=data,
    headers={'Content-Type': 'application/json', 'Authorization': 'Bearer nina-local'}
)

try:
    with urllib.request.urlopen(req) as response:
        res = json.loads(response.read().decode('utf-8'))
        if 'choices' in res and res['choices']:
            print(res['choices'][0]['message']['content'])
        else:
            print(f'[nina-shim] NinaGate response format unexpected: {res}', file=sys.stderr)
            sys.exit(1)
except Exception as e:
    print(f'[nina-shim] NinaGate request failed: {e}', file=sys.stderr)
    sys.exit(1)
" "$@"
