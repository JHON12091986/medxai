{
  "template_id": "expense_log",
  "name": "Expense Log",
  "description": "Parse expense amount and category from user message, validate format, write to finance tool, confirm to user",
  "trigger_keywords": ["expense", "spent", "bought", "paid", "cost"],
  "steps": [
    {
      "step_id": "parse_expense",
      "description": "Parse expense amount and category from user message",
      "tool": "memory",
      "args_template": {
        "action": "extract_expense",
        "text": "$user_input"
      },
      "depends_on": [],
      "timeout_seconds": 15,
      "success_criteria": "Amount and category extracted successfully"
    },
    {
      "step_id": "log_finance",
      "description": "Write expense to finance tool",
      "tool": "finance",
      "args_template": {
        "action": "log_expense",
        "amount": "$parse_expense.output.amount",
        "category": "$parse_expense.output.category"
      },
      "depends_on": ["parse_expense"],
      "timeout_seconds": 20,
      "success_criteria": "Expense written to finance tool successfully"
    },
    {
      "step_id": "confirm_user",
      "description": "Confirm successful log to user via Telegram",
      "tool": "telegram",
      "args_template": {
        "action": "send_message",
        "message": "Logged expense: $parse_expense.output.amount for $parse_expense.output.category"
      },
      "depends_on": ["log_finance"],
      "timeout_seconds": 10,
      "success_criteria": "Confirmation message sent to user"
    }
  ]
}