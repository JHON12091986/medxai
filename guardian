#!/usr/bin/env bash
# guardian
# NINA Guardian 2.0 — Production Forensic Gate
# Orchestration entry point. Absorbs and extends all logic from nina-guardian.sh.
# Safe to re-run repeatedly. Executable, no .sh extension.
# Usage: guardian [--skip-deploy] [--json-only] [--no-color]

set +e

# ── Flags ─────────────────────────────────────────────────────────────────────
SKIP_DEPLOY=0
JSON_ONLY=0
NO_COLOR=0
for arg in "$@"; do
  case "$arg" in
    --skip-deploy) SKIP_DEPLOY=1 ;;
    --json-only)   JSON_ONLY=1   ;;
    --no-color)    NO_COLOR=1    ;;
  esac
done

# ── Colors ────────────────────────────────────────────────────────────────────
if [ "$NO_COLOR" -eq 0 ] && [ -t 1 ]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  NC='\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' NC=''
fi

# ── Helpers ───────────────────────────────────────────────────────────────────
section() { echo -e "\n${CYAN}${BOLD}── $1 $(printf '─%.0s' $(seq 1 $((55 - ${#1}))))${NC}"; }
pass()    { echo -e "  ${GREEN}✔${NC}  $1"; }
fail()    { echo -e "  ${RED}✖${NC}  ${RED}$1${NC}"; ERRORS=$((ERRORS + 1)); }
warn()    { echo -e "  ${YELLOW}⚠${NC}  ${YELLOW}$1${NC}"; }
info()    { echo -e "  ${CYAN}ℹ${NC}  $1"; }

ERRORS=0

# ── Paths ─────────────────────────────────────────────────────────────────────
NINA_DIR="$HOME/nina"
VENV_DIR="$NINA_DIR/venv"
UPGRADES_DIR="$NINA_DIR/upgrades"
BACKUPS_DIR="$UPGRADES_DIR/backups"
INCIDENTS_DIR="$UPGRADES_DIR/incidents"
DEPLOY_LOG="$UPGRADES_DIR/deploy.log"
PIDFILE="$NINA_DIR/data/nina.pid"
ENGINE_PY="$NINA_DIR/guardian_engine.py"
HEALTHCHECK_PY="$NINA_DIR/healthcheck.py"
ENV_FILE="$NINA_DIR/.env"
HANDOFF_JSON="$UPGRADES_DIR/.guardian_handoff.json"

TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
HUMAN_TS=$(date '+%Y-%m-%d %H:%M:%S')

# ── Banner ────────────────────────────────────────────────────────────────────
if [ "$JSON_ONLY" -eq 0 ]; then
  echo -e "\n${BOLD}${CYAN}"
  echo "  ╔═══════════════════════════════════════════════════════╗"
  echo "  ║         NINA Guardian 2.0 — Forensic Gate             ║"
  echo "  ║         $(date '+%Y-%m-%d %H:%M:%S')                         ║"
  echo "  ╚═══════════════════════════════════════════════════════╝"
  echo -e "${NC}"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §1 · Directory sanity
# ─────────────────────────────────────────────────────────────────────────────
section "1 · Directory Sanity"

if [ ! -d "$NINA_DIR" ]; then
  fail "~/nina directory not found — aborting"
  exit 1
fi
pass "~/nina exists"

for dir in "$UPGRADES_DIR" "$BACKUPS_DIR" "$INCIDENTS_DIR" "$NINA_DIR/data" "$NINA_DIR/logs"; do
  mkdir -p "$dir"
done
pass "Required directories present"

if [ ! -f "$ENV_FILE" ]; then
  fail ".env file missing at $ENV_FILE"
  ERRORS=$((ERRORS + 1))
else
  pass ".env file present"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §2 · Python / venv detection
# ─────────────────────────────────────────────────────────────────────────────
section "2 · Python / venv Detection"

if [ -f "$VENV_DIR/bin/python" ]; then
  PYTHON="$VENV_DIR/bin/python"
  PYTHON_VERSION=$("$PYTHON" --version 2>&1)
  pass "venv Python active: $PYTHON_VERSION"
elif command -v python3 &>/dev/null; then
  PYTHON="python3"
  PYTHON_VERSION=$(python3 --version 2>&1)
  warn "venv not found — falling back to system: $PYTHON_VERSION"
  ERRORS=$((ERRORS + 1))
else
  fail "No Python interpreter found — aborting"
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# §3 · Required package validation
# ─────────────────────────────────────────────────────────────────────────────
section "3 · Required Package Validation"

REQUIRED_PACKAGES=("telegram" "apscheduler" "pydantic" "dotenv" "aiohttp" "aiofiles" "pyflakes" "mypy" "psutil" "numpy")
PKG_FAIL=0
for pkg in "${REQUIRED_PACKAGES[@]}"; do
  if "$PYTHON" -c "import $pkg" 2>/dev/null; then
    pass "$pkg"
  else
    # Try alternate import names
    ALT_NAME="$pkg"
    case "$pkg" in
      telegram)  ALT_NAME="telegram" ;;
      dotenv)    ALT_NAME="dotenv" ;;
    esac
    if "$PYTHON" -c "import $ALT_NAME" 2>/dev/null; then
      pass "$pkg (via $ALT_NAME)"
    else
      fail "Package missing: $pkg"
      PKG_FAIL=1
    fi
  fi
done

if [ "$PKG_FAIL" -eq 1 ]; then
  warn "Some packages missing — run: source $VENV_DIR/bin/activate && pip install -r requirements.txt"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §4 · Env key preflight (BLOCKER-class validation in bash)
# ─────────────────────────────────────────────────────────────────────────────
section "4 · Env Key Preflight"

ENV_BLOCKER=0

check_env_key() {
  local key="$1"
  local blocking="$2"
  local val
  val=$(grep -E "^${key}=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '[:space:]') || val=""
  if [ -n "$val" ]; then
    pass "$key present"
  else
    if [ "$blocking" = "BLOCKER" ]; then
      fail "$key MISSING or EMPTY — BLOCKER"
      ENV_BLOCKER=1
    else
      warn "$key missing (non-blocking, advisory)"
    fi
  fi
}

set +e
  check_env_key "TELEGRAMBOTTOKEN"   "BLOCKER"
check_env_key "AUTHORIZEDUSERID"   "BLOCKER"
check_env_key "APISECRETKEY"         "BLOCKER"
#   set -e
check_env_key "TELEGRAMCHATID"     "ADVISORY"

if [ "$ENV_BLOCKER" -eq 1 ]; then
  fail "One or more BLOCKER env keys are missing — deploy will be blocked by engine"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §5 · Ghost process / lock file check
# ─────────────────────────────────────────────────────────────────────────────
section "5 · Ghost Process / Lock File"

GHOST=0
if [ -f "$PIDFILE" ]; then
  OLD_PID=$(cat "$PIDFILE" 2>/dev/null | tr -d '[:space:]')
  if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    warn "Existing NINA process found at PID $OLD_PID"
    info  "This is expected before a restart — systemctl will handle it"
  else
    info "PID file exists but process $OLD_PID is not running (stale)"
  fi
fi

if [ -f "$NINA_DIR/data/nina.lock" ]; then
  # Check if any live process holds this lock
  LOCK_HOLDER=$(fuser "$NINA_DIR/data/nina.lock" 2>/dev/null || true)
  if [ -n "$LOCK_HOLDER" ]; then
    warn "nina.lock held by PID $LOCK_HOLDER — may cause startup conflict"
    GHOST=1
  else
    info "nina.lock exists but is not held by any process"
  fi
fi

if [ "$GHOST" -eq 1 ]; then
  warn "Potential ghost instance detected — guardian_engine.py will log this"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §6 · Syntax check (pyflakes)
# ─────────────────────────────────────────────────────────────────────────────
section "6 · Syntax Check (pyflakes)"

PYFLAKES_FAIL=0
PY_FILES=(
  "main.py"
  "core/config.py"
  "core/router.py"
  "core/nina.py"
  "core/agent.py"
  "core/memory.py"
  "core/logger.py"
  "core/hotreload.py"
  "core/capabilities.py"
  "interfaces/telegram_interface.py"
  "tools/shell.py"
  "tools/browser.py"
  "tools/upgradepipeline.py"
  "tools/officemail.py"
  "tools/system.py"
  "crons/manager.py"
  "idleloop.py"
)

for rel_path in "${PY_FILES[@]}"; do
  full_path="$NINA_DIR/$rel_path"
  if [ -f "$full_path" ]; then
    PYFLAKES_OUT=$("$PYTHON" -m pyflakes "$full_path" 2>&1)
    if [ -z "$PYFLAKES_OUT" ]; then
      pass "$rel_path — clean"
    else
      warn "$rel_path — pyflakes issues:"
      echo "$PYFLAKES_OUT" | head -5 | while IFS= read -r line; do
        info "    $line"
      done
      PYFLAKES_FAIL=1
    fi
  else
    info "$rel_path — not found, skipping"
  fi
done

if [ "$PYFLAKES_FAIL" -eq 1 ]; then
  warn "pyflakes found issues — review above before committing"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §7 · Import-time error check
# ─────────────────────────────────────────────────────────────────────────────
section "7 · Import-time Error Check"

IMPORT_CHECK_OUT=$(cd "$NINA_DIR" && "$PYTHON" -c "
import sys, traceback
modules = [
    'core.config',
    'core.logger',
    'core.capabilities',
    'core.memory',
    'core.router',
    'core.agent',
]
failed = []
for mod in modules:
    try:
        __import__(mod)
    except (NameError, TypeError, AttributeError, ImportError, SyntaxError) as e:
        failed.append(f'{mod}: {type(e).__name__}: {e}')
    except Exception as e:
        failed.append(f'{mod}: {type(e).__name__}: {e}')
if failed:
    for f in failed:
        print(f'IMPORT_FAIL: {f}')
    sys.exit(1)
else:
    print('IMPORT_OK: all core modules imported cleanly')
" 2>&1)

IMPORT_EXIT=$?
echo "$IMPORT_CHECK_OUT" | while IFS= read -r line; do
  if echo "$line" | grep -q "IMPORT_FAIL"; then
    fail "$line"
  elif echo "$line" | grep -q "IMPORT_OK"; then
    pass "$line"
  else
    info "$line"
  fi
done

if [ "$IMPORT_EXIT" -ne 0 ]; then
  fail "Core module import check failed — BLOCKER errors present"
  ERRORS=$((ERRORS + 1))
fi

# ─────────────────────────────────────────────────────────────────────────────
# §8 · Healthcheck.py
# ─────────────────────────────────────────────────────────────────────────────
section "8 · Startup Safety Assertions (healthcheck.py)"

HEALTHCHECK_EXIT=0
if [ -f "$HEALTHCHECK_PY" ]; then
  HEALTHCHECK_OUT=$(cd "$NINA_DIR" && "$PYTHON" healthcheck.py 2>&1) || HEALTHCHECK_EXIT=$?
  echo "$HEALTHCHECK_OUT" | head -20 | while IFS= read -r line; do
    if echo "$line" | grep -qiE "BLOCKER|FAIL|Error|Exception"; then
      fail "  hc: $line"
    elif echo "$line" | grep -qiE "WARN|Warning"; then
      warn "  hc: $line"
    elif echo "$line" | grep -qiE "PASS|OK|clean"; then
      pass "  hc: $line"
    else
      info "  hc: $line"
    fi
  done
  if [ "$HEALTHCHECK_EXIT" -eq 0 ]; then
    pass "healthcheck.py passed (exit 0)"
  else
    fail "healthcheck.py returned exit $HEALTHCHECK_EXIT"
    ERRORS=$((ERRORS + 1))
  fi
else
  warn "healthcheck.py not found — skipping"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §9 · Static type check (mypy — advisory, non-blocking)
# ─────────────────────────────────────────────────────────────────────────────
section "9 · Static Type Check (mypy — advisory)"

if "$PYTHON" -m mypy --version &>/dev/null; then
  MYPY_OUT=$(cd "$NINA_DIR" && "$PYTHON" -m mypy \
    --ignore-missing-imports \
    --no-error-summary \
    core/config.py core/router.py core/agent.py \
    interfaces/telegram_interface.py \
    2>&1 | head -30)
  MYPY_ERRORS=$(echo "$MYPY_OUT" | grep -c "error:" || true)
  if [ "$MYPY_ERRORS" -eq 0 ]; then
    pass "mypy — no findings"
  else
    warn "mypy — $MYPY_ERRORS advisory finding(s) (non-blocking)"
    echo "$MYPY_OUT" | grep "error:" | head -5 | while IFS= read -r line; do
      info "    mypy: $line"
    done
  fi
else
  warn "mypy not found in venv — install with: pip install mypy"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §10 · Backup snapshot
# ─────────────────────────────────────────────────────────────────────────────
section "10 · Backup Snapshot"

AUTO_BACKUP="$BACKUPS_DIR/backup_${TIMESTAMP}"
mkdir -p "$AUTO_BACKUP"

# Copy all tracked source files preserving directory structure
BACKUP_MANIFEST=()
for rel_path in "${PY_FILES[@]}"; do
  full_path="$NINA_DIR/$rel_path"
  if [ -f "$full_path" ]; then
    dest_dir="$AUTO_BACKUP/$(dirname "$rel_path")"
    mkdir -p "$dest_dir"
    cp "$full_path" "$dest_dir/"
    BACKUP_MANIFEST+=("$rel_path")
  fi
done

# Also backup .env presence flag (never copy the actual .env)
if [ -f "$ENV_FILE" ]; then
  echo "env_present=true" > "$AUTO_BACKUP/.env_flag"
fi

# Write manifest
printf '%s\n' "${BACKUP_MANIFEST[@]}" > "$AUTO_BACKUP/MANIFEST.txt"
echo "backup_ts=$HUMAN_TS" >> "$AUTO_BACKUP/MANIFEST.txt"

BACKUP_COUNT=${#BACKUP_MANIFEST[@]}
pass "Backup created: $AUTO_BACKUP ($BACKUP_COUNT files)"

# Rotate: keep last 10 backups only
BACKUP_LIST=($(ls -1dt "$BACKUPS_DIR"/backup_* 2>/dev/null))
if [ "${#BACKUP_LIST[@]}" -gt 10 ]; then
  for old in "${BACKUP_LIST[@]:10}"; do
    rm -rf "$old"
  done
  info "Old backups pruned — kept 10 most recent"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §11 · Markdown export (human-readable codebase snapshot)
# ─────────────────────────────────────────────────────────────────────────────
section "11 · Markdown Export"

EXPORT_OUT="$BACKUPS_DIR/nina_export_${TIMESTAMP}.md"
{
  echo "# NINA Codebase Export"
  echo ""
  echo "**Generated:** $HUMAN_TS"
  echo "**Host:** $(hostname)"
  echo "**Guardian version:** 2.0"
  echo ""
  echo "## File Index"
  echo ""
  for rel_path in "${PY_FILES[@]}"; do
    full_path="$NINA_DIR/$rel_path"
    if [ -f "$full_path" ]; then
      LINES=$(wc -l < "$full_path")
      MTIME=$(stat -c '%y' "$full_path" 2>/dev/null | cut -d'.' -f1)
      echo "- \`$rel_path\` — $LINES lines — last modified: $MTIME"
    fi
  done
  echo ""
  echo "---"
  echo ""
  for rel_path in "${PY_FILES[@]}"; do
    full_path="$NINA_DIR/$rel_path"
    if [ -f "$full_path" ]; then
      LINES=$(wc -l < "$full_path")
      MTIME=$(stat -c '%y' "$full_path" 2>/dev/null | cut -d'.' -f1)
      echo "### \`$rel_path\`"
      echo ""
      echo "> Last modified: $MTIME | Lines: $LINES"
      echo ""
      echo '```python'
      # Redact bot tokens from export
      sed 's/bot[0-9]*:[A-Za-z0-9_-]*/bot***:***/g' "$full_path"
      echo '```'
      echo ""
      echo "---"
      echo ""
    fi
  done
} > "$EXPORT_OUT"

pass "Markdown export: $EXPORT_OUT"

# ─────────────────────────────────────────────────────────────────────────────
# §12 · Guardian Engine — forensic analysis
# ─────────────────────────────────────────────────────────────────────────────
section "12 · Forensic Engine"

ENGINE_EXIT=0
if [ ! -f "$ENGINE_PY" ]; then
  fail "guardian_engine.py not found at $ENGINE_PY — cannot run forensic analysis"
  ERRORS=$((ERRORS + 1))
  ENGINE_EXIT=1
else
  if [ "$JSON_ONLY" -eq 1 ]; then
    "$PYTHON" "$ENGINE_PY" --json-only
    ENGINE_EXIT=$?
  else
    "$PYTHON" "$ENGINE_PY"
    ENGINE_EXIT=$?
  fi
fi

# Read handoff from engine
ENGINE_STATUS="UNKNOWN"
ENGINE_BLOCKED=0
ENGINE_INCIDENT_DIR=""
ENGINE_JSON_REPORT=""
ENGINE_ROOT_CAUSE="unknown"
ENGINE_HEALTH_SCORE=0

if [ -f "$HANDOFF_JSON" ]; then
  ENGINE_STATUS=$(python3 -c "import json; d=json.load(open('$HANDOFF_JSON')); print(d.get('overall_status','UNKNOWN'))" 2>/dev/null || echo "UNKNOWN")
  ENGINE_BLOCKED=$(python3 -c "import json; d=json.load(open('$HANDOFF_JSON')); print(1 if d.get('deploy_blocked') else 0)" 2>/dev/null || echo "1")
  ENGINE_INCIDENT_DIR=$(python3 -c "import json; d=json.load(open('$HANDOFF_JSON')); print(d.get('incident_dir',''))" 2>/dev/null || echo "")
  ENGINE_JSON_REPORT=$(python3 -c "import json; d=json.load(open('$HANDOFF_JSON')); print(d.get('json_report',''))" 2>/dev/null || echo "")
  ENGINE_ROOT_CAUSE=$(python3 -c "import json; d=json.load(open('$HANDOFF_JSON')); print(d.get('root_cause_title','unknown'))" 2>/dev/null || echo "unknown")
  ENGINE_HEALTH_SCORE=$(python3 -c "import json; d=json.load(open('$HANDOFF_JSON')); print(d.get('health_score',0))" 2>/dev/null || echo "0")
fi

if [ "$ENGINE_EXIT" -eq 0 ]; then
  pass "Forensic engine completed — status: $ENGINE_STATUS"
else
  fail "Forensic engine reported failures — status: $ENGINE_STATUS"
  ERRORS=$((ERRORS + 1))
fi

if [ -n "$ENGINE_JSON_REPORT" ] && [ -f "$ENGINE_JSON_REPORT" ]; then
  info "JSON report: $ENGINE_JSON_REPORT"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §13 · Deploy gate
# ─────────────────────────────────────────────────────────────────────────────
section "13 · Deploy Gate"

if [ "$SKIP_DEPLOY" -eq 1 ]; then
  warn "Deploy skipped (--skip-deploy flag)"
elif [ "$ENGINE_BLOCKED" -eq 1 ]; then
  fail "Deploy BLOCKED by forensic engine — $ENGINE_ROOT_CAUSE"
  fail "Fix the above issues and re-run guardian"
  echo ""
  echo -e "  ${RED}${BOLD}Deploy blocked. NINA has NOT been restarted.${NC}"
  echo -e "  ${YELLOW}Rollback available: see $ENGINE_INCIDENT_DIR${NC}"
  echo ""
  # Log the blocked deploy
  echo "[$HUMAN_TS] BLOCKED — root_cause: $ENGINE_ROOT_CAUSE — score: $ENGINE_HEALTH_SCORE — errors: $ERRORS" >> "$DEPLOY_LOG"
  exit 1
else
  # ── Restart service ───────────────────────────────────────────────────────
  info "Restarting nina.service..."
  if sudo systemctl restart nina 2>&1; then
    pass "systemctl restart nina — OK"
  else
    fail "systemctl restart nina — FAILED"
    ERRORS=$((ERRORS + 1))
  fi

  # ── Wait for service to settle ────────────────────────────────────────────
  sleep 5

  # ── Verify active state ───────────────────────────────────────────────────
  if systemctl is-active --quiet nina; then
    pass "nina.service is active"
  else
    fail "nina.service failed to come up after restart"
    ERRORS=$((ERRORS + 1))
    echo "[$HUMAN_TS] RESTART_FAIL — service did not come up — errors: $ERRORS" >> "$DEPLOY_LOG"
    exit 1
  fi

  # ── PID capture ───────────────────────────────────────────────────────────
  NEW_PID=$(systemctl show nina --property=MainPID 2>/dev/null | cut -d'=' -f2 | tr -d '[:space:]')
  if [ -n "$NEW_PID" ] && [ "$NEW_PID" != "0" ]; then
    echo "$NEW_PID" > "$PIDFILE"
    pass "PID $NEW_PID written to $PIDFILE"
  else
    warn "Could not determine new PID"
  fi

  # ── Wait for Telegram polling ─────────────────────────────────────────────
  info "Waiting up to 20s for Telegram polling confirmation..."
  POLL_CONFIRMED=0
  for i in $(seq 1 20); do
    RECENT_LOG=$(journalctl -u nina -n 50 --no-pager 2>/dev/null \
      | sed 's/bot[0-9]*:[A-Za-z0-9_-]*/bot***:***/g')
    if echo "$RECENT_LOG" | grep -qiE 'polling started|Application started|getUpdates'; then
      pass "Telegram polling confirmed (${i}s)"
      POLL_CONFIRMED=1
      break
    fi
    sleep 1
  done
  if [ "$POLL_CONFIRMED" -eq 0 ]; then
    warn "Telegram polling not confirmed within 20s — service may still be initializing"
  fi

  # ── APScheduler check ─────────────────────────────────────────────────────
  SCHED_LOG=$(journalctl -u nina -n 100 --no-pager 2>/dev/null)
  if echo "$SCHED_LOG" | grep -qiE 'Scheduler started|APScheduler'; then
    pass "APScheduler startup confirmed"
  else
    warn "APScheduler startup not confirmed in logs"
  fi

  # ── Crash pattern check ───────────────────────────────────────────────────
  CRASH_LOG=$(journalctl -u nina -n 50 --no-pager 2>/dev/null)
  if echo "$CRASH_LOG" | grep -qiE 'Traceback|NameError|ImportError|ModuleNotFoundError|AttributeError|SyntaxError'; then
    fail "Crash pattern found in post-restart logs"
    ERRORS=$((ERRORS + 1))
  else
    pass "No crash pattern in post-restart logs"
  fi

  # ── Crash loop check (rapid restarts) ─────────────────────────────────────
  START_COUNT=$(journalctl -u nina --since "60 seconds ago" --no-pager 2>/dev/null \
    | grep -c "Started.*nina\|Starting.*nina" || true)
  if [ "$START_COUNT" -ge 3 ]; then
    fail "Crash loop detected — $START_COUNT start events in last 60s"
    ERRORS=$((ERRORS + 1))
  else
    pass "No crash loop detected ($START_COUNT start event(s) in last 60s)"
  fi

  # ── Log directory writable check ──────────────────────────────────────────
  if [ -w "$NINA_DIR/logs" ]; then
    pass "Log directory is writable"
  else
    warn "Log directory may not be writable: $NINA_DIR/logs"
  fi

  # ── Ollama check (non-blocking) ───────────────────────────────────────────
  OLLAMA_OK=$(curl -s --max-time 3 http://localhost:11434/api/tags 2>/dev/null | grep -c "models" || true)
  if [ "$OLLAMA_OK" -ge 1 ]; then
    pass "Ollama local inference responding"
  else
    warn "Ollama not responding (non-blocking — cloud providers available)"
  fi

  # ── Deploy log ────────────────────────────────────────────────────────────
  echo "[$HUMAN_TS] deploy — pid:$NEW_PID — backup:$(basename "$AUTO_BACKUP") — export:$(basename "$EXPORT_OUT") — score:$ENGINE_HEALTH_SCORE — errors:$ERRORS" >> "$DEPLOY_LOG"
  pass "Deploy logged to $DEPLOY_LOG"
fi

# ─────────────────────────────────────────────────────────────────────────────
# §14 · Final summary
# ─────────────────────────────────────────────────────────────────────────────
section "14 · Final Summary"

if [ "$ERRORS" -eq 0 ]; then
  echo -e "\n  ${GREEN}${BOLD}All checks passed — NINA is healthy 🎉${NC}"
  echo -e "  ${CYAN}Health score: $ENGINE_HEALTH_SCORE/10${NC}"
  echo -e "  ${CYAN}Status: $ENGINE_STATUS${NC}\n"
elif [ "$ENGINE_STATUS" = "WARN" ]; then
  echo -e "\n  ${YELLOW}${BOLD}Guardian completed with warnings — $ERRORS issue(s)${NC}"
  echo -e "  ${CYAN}Health score: $ENGINE_HEALTH_SCORE/10${NC}"
  echo -e "  ${CYAN}NINA is running but advisory items remain${NC}\n"
else
  echo -e "\n  ${RED}${BOLD}Guardian found $ERRORS issue(s) — review findings above${NC}"
  echo -e "  ${CYAN}Health score: $ENGINE_HEALTH_SCORE/10${NC}"
  if [ -n "$ENGINE_INCIDENT_DIR" ]; then
    echo -e "  ${YELLOW}Incident artifacts: $ENGINE_INCIDENT_DIR${NC}"
  fi
  echo ""
  exit 1
fi
