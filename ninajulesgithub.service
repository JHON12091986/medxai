[Unit]
Description=NinaJulesGitHub — Autonomous Jules/GitHub Pipeline Daemon
After=network.target
Documentation=file:///home/aibony/nina/ninajulesgithub.py

[Service]
Type=simple
User=aibony
WorkingDirectory=/home/aibony/nina
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/aibony/nina/venv/bin/python /home/aibony/nina/ninajulesgithub.py
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
